DATABASE_URL=postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5432/ethical_edge_db

# Continuous Control Monitoring Integration Keys
MOCK_CLIENT_GITHUB_ORG="your-github-org-name"
MOCK_CLIENT_GITHUB_TOKEN="ghp_yourActualGitHubPersonalAccessToken"
AWS_ACCESS_KEY_ID="your_aws_access_key"
AWS_SECRET_ACCESS_KEY="your_aws_secret_key"
AWS_DEFAULT_REGION="us-east-1"
